"use client";

import i18n from "i18next";
import { initReactI18next } from "react-i18next";

const resources = {
  en: {
    translation: {
      "welcome": "Welcome to GI Book",
      "languageChanged": "Language changed successfully!",
      "search": "Search",
      "settings": "Settings",
      "logout": "Logout",
    }
  },
  hi: {
    translation: {
      "welcome": "जीआई बुक में आपका स्वागत है",
      "languageChanged": "भाषा सफलतापूर्वक बदल दी गई!",
      "search": "खोज",
      "settings": "सेटिंग्स",
      "logout": "लॉग आउट",
    }
  }
};

i18n
  .use(initReactI18next)
  .init({
    resources,
    lng: "en", // default language
    fallbackLng: "en",
    interpolation: {
      escapeValue: false // react already safes from xss
    }
  });

export default i18n;
